{
  "name": "StatusSprite",
  "grid": {
    "canvas": 150,
    "cell": 50,
    "columns": 3,
    "rows": 3,
    "unit": "px",
    "naming": "Groups cell-a … cell-i (row-major). Children cell-a-dim / cell-a-lit (unique ids; Figma layer names).",
    "note": "150×150 viewBox with 50px cells so dot r, square inset/size/rx are whole pixels (16 / 7 / 36 / 5)."
  },
  "cells": [
    "cell-a",
    "cell-b",
    "cell-c",
    "cell-d",
    "cell-e",
    "cell-f",
    "cell-g",
    "cell-h",
    "cell-i"
  ],
  "cellOrder": "Row-major a–i, left-to-right, top-to-bottom, matching STATUS_FRAMES.",
  "geometry": {
    "dot": {
      "r": 16,
      "fromCellFraction": 0.32
    },
    "square": {
      "inset": 7,
      "size": 36,
      "rx": 5,
      "fromCellFraction": {
        "inset": 0.14,
        "size": 0.72,
        "rx": 0.1
      }
    }
  },
  "colors": {
    "light": {
      "lit": "#141414",
      "dim": "#d6d6d6",
      "figmaVariables": {
        "lit": "status/lit",
        "dim": "status/dim"
      }
    },
    "dark": {
      "lit": "#ededed",
      "dim": "#3a3a3a",
      "figmaVariables": {
        "lit": "status/lit",
        "dim": "status/dim"
      }
    }
  },
  "speed": {
    "default": 90,
    "formula": "scaledMs = specMs * (speed / 90). Loop length and every frame hold scale the same way. An explicit duration prop replaces the whole loop length and still keeps internal hold/rest ratios."
  },
  "wait": {
    "sampleCount": 8,
    "periodMs": 2400,
    "note": "Wait is a sine (waitCenterLevel), not the 6 glyph snapshots in STATUS_FRAMES.Wait. Exported as 8 keyframes at t = i * 2400 / 8, using the real (unquantized) center brightness."
  },
  "layerTree": "9 groups (cell-a … cell-i), each with dim (LED-off base) then lit (LED-on, opacity = brightness). lit is present even at opacity 0 so every frame has the same tree for Smart Animate.",
